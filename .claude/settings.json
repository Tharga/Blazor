    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(gh repo delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard *)"
    ]
  }
}
