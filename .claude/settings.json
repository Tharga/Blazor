{
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Skill(update-config:*)",
      "WebFetch(domain:api.nuget.org)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(npm publish *)",
      "Bash(dotnet nuget push *)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
