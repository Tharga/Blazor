@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject NotificationService NotificationService

<StandardButton Text="Copy" Icon="content_copy" Click="CopyAction" Size="@Size" />

@code {
    [Parameter]
    public string Content { get; set; }

    [Parameter]
    public ButtonSize Size { get; set; }

    private async Task CopyAction()
    {
        if (string.IsNullOrWhiteSpace(Content))
        {
            NotificationService.Notify(new NotificationMessage { Summary = "Nothig to copy.", Severity = NotificationSeverity.Warning });
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("clipboard.copyText", Content);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException)
        {
            NotificationService.Notify(new NotificationMessage { Summary = "Could not copy to the clipboard.", Severity = NotificationSeverity.Warning });
            return;
        }

        NotificationService.Notify(new NotificationMessage { Summary = "Content has been copied.", Severity = NotificationSeverity.Info });
    }

}
