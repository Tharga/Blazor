@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Options
@using Tharga.Blazor.Framework
@rendermode CustomRenderModes.StandardMode
@inject NavigationManager NavigationManager
@inject IOptions<BlazorOptions> Options
@implements IDisposable

@if (ChildContent != null)
{
    <PageTitle>@($"{MainTitle} - ") @ChildContent</PageTitle>
}
else
{
    <PageTitle>@($"{MainTitle}{_autoTitle}")</PageTitle>
}

@code {
    private string _autoTitle;

    private string MainTitle { get; set; } = "Untitled";

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    protected override Task OnInitializedAsync()
    {
        MainTitle = Options?.Value.Title;
        NavigationManager.LocationChanged += OnLocationChanged;
        BuildAutoTitle();

        return base.OnInitializedAsync();
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        BuildAutoTitle();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void BuildAutoTitle()
    {
        var first = NavigationPath.Segments(NavigationManager).FirstOrDefault();
        _autoTitle = string.IsNullOrEmpty(first) ? null : $" - {char.ToUpper(first[0])}{first.Substring(1)}";
        StateHasChanged();
    }

}
